# Echter Betrieb auf pflanzfarm.ch (Vorlage; einfacher: «artisan.sh pflanzfarm:domain pflanzfarm.ch --live» auf der bestehenden Installation)
# Vorlage für eine Neuinstallation: nach backend/.env kopieren und Werte mit «ÄNDERN» anpassen.
APP_NAME=Pflanzfarm
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pflanzfarm.ch
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL-Datenbank aus konsoleH (Datenbanken → MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ÄNDERN
DB_USERNAME=ÄNDERN
DB_PASSWORD=ÄNDERN

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=pflanzfarm.ch,www.pflanzfarm.ch
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# E-Mails über Resend – am einfachsten mit «sh backend/deploy/artisan.sh pflanzfarm:einrichten» setzen.
# «log» = nichts wird verschickt (landet in storage/logs/laravel.log).
MAIL_MAILER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM_ADDRESS="shop@pflanzfarm.ch"
MAIL_FROM_NAME="Pflanzfarm Steinmann"

# Echter Betrieb
PFLANZFARM_TEST_MODE=false
SITE_PASSWORD=
# Stripe Live-Schlüssel (sk_live_…)
STRIPE_FAKE=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_METHODS=card,twint

