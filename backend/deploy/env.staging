# Testbetrieb auf Hetzner-Webhosting (pflanzfarm.gross-ict.ch)
# Diese Datei wird beim ersten Lauf von deploy/install.sh als .env kopiert. Werte mit «ÄNDERN» anpassen.
APP_NAME=Pflanzfarm
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://pflanzfarm.gross-ict.ch
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL-Datenbank aus konsoleH (Datenbanken → MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ÄNDERN
DB_USERNAME=ÄNDERN
DB_PASSWORD=ÄNDERN

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=pflanzfarm.gross-ict.ch
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# E-Mails: «log» = nichts wird verschickt (landen in storage/logs/laravel.log).
# Für echte Test-Mails: MAIL_MAILER=resend und RESEND_API_KEY setzen.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="shop@pflanzfarm.ch"
MAIL_FROM_NAME="Pflanzfarm Steinmann (Test)"

# Testbetrieb: gelber Hinweisbalken, simulierte Zahlung; SITE_PASSWORD optional (leer = ohne Passwortabfrage)
PFLANZFARM_TEST_MODE=true
STRIPE_FAKE=true
SITE_PASSWORD=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_METHODS=card,twint

# Test-Admin (wird beim ersten Lauf angelegt)
TEST_ADMIN_EMAIL=admin@pflanzfarm.test
TEST_ADMIN_PASSWORD=ÄNDERN
